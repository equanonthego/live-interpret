# 실제 값을 채워 .env.local 로 저장하세요 (.env.local 은 git에 올라가지 않습니다).

# Google AI Studio 유료 키 (Gemini 3.5 Live Translate 사용에 유료 티어 필요)
GEMINI_API_KEY=

# LiveKit Cloud 프로젝트 (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# (선택) 방송 비밀번호. 설정하면 세션 생성(강사) 시 이 암호를 요구한다.
# 청자 시청은 제한하지 않는다. 비워두면 게이트 없음(개인 사용/개발).
# 학교 등 공용 배포에서 강사만 방송을 열게 해 LiveKit·서버 자원을 보호하는 용도.
BROADCAST_PASSWORD=

# (선택) 사용량 계량을 통화로 환산할 100만 토큰당 USD 단가. 미설정 시 방송
# 패널은 금액 없이 토큰 수만 표시한다. gemini-3.5-live-translate-preview는
# 프리뷰라 공개 단가가 확정되지 않아 기본값을 두지 않는다.
# GEMINI_LIVE_USD_PER_1M_TOKENS=
